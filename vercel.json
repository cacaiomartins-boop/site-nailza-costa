{
  "redirects": [{ "source": "/index.html", "destination": "/", "permanent": true }],
  "rewrites": [
    {
      "source": "/terapia/:slug(brasileiros-no-exterior|ansiedade-e-angustia|depressao-e-humor|luto-e-perdas|relacionamentos-e-autoestima|saude-e-adoecimento|comida-corpo-e-emocao|familia-e-maternidade)",
      "destination": "/index.html"
    },
    { "source": "/privacidade", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/img/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800, stale-while-revalidate=86400" }]
    }
  ]
}
